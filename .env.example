# YouTube Data API v3 Anahtarı (Google Cloud Console'dan alınır)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Takip edilecek YouTube Kanal ID'si (Örn: UCxxxxxxxxxxxxxxxx)
YOUTUBE_CHANNEL_ID=your_channel_id_here
# Veya çoklu kanal için virgülle ayrılmış liste:
# YOUTUBE_CHANNELS=@uykusuztosba,@radiomocas

# Instagram & Apify Ayarları (Meta API ve giriş gerektirmez)
# Apify API Token (apify.com üzerinden ücretsiz alınabilir)
APIFY_API_TOKEN=your_apify_api_token_here
# Takip edilecek Instagram hesapları (Virgülle ayrılmış liste, örn: radiomocas, uykusuztosba)
INSTAGRAM_PROFILES=your_instagram_profile
# Hesap başına kontrol edilecek son gönderi sayısı (Varsayılan: 3)
RECENT_INSTAGRAM_POSTS_COUNT=3

# Google Gemini API Anahtarı (aistudio.google.com adresinden ücretsiz alınır)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bildirimleri (Opsiyonel ama önerilir - @BotFather ile oluşturulur)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Cloud Project ID (Firestore ve Cloud Function için)
GCP_PROJECT_ID=your_gcp_project_id_here

# Yerel test modu (true ise Firestore yerine yerel SQLite veritabanı kullanılır)
USE_LOCAL_DB=false

